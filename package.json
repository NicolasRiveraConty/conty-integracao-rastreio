{
  "name": "conty-integracao-rastreio",
  "version": "1.0.0",
  "private": true,
  "description": "API de rastreio da Conty: cadastra código, normaliza o status do agregador e avisa atraso de trânsito.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "aggregator": "tsx src/dev/fake-aggregator.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
